# Claude API key (default backend)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model
# RECREATOR_MODEL=claude-sonnet-4-6

# Optional: select translation backend (claude | local-in-future)
# TRANSLATE_BACKEND=claude

# Monitoring: YouTube Data API v3 key
YOUTUBE_API_KEY=

# Notifications: SMTP for the digest email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# SMTP_TLS=true
