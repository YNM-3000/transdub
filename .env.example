# Transdub configuration. Copy to .env and fill in what you need.
# Everything here is optional — a fully local run (Ollama + Whisper + Kokoro/
# GPT-SoVITS) needs no cloud keys at all.

# --- Cloud LLM (translation/publish fallback, or primary with --backend claude) ---
ANTHROPIC_API_KEY=
# Override the Claude model used for translate/publish
# TRANSDUB_MODEL=claude-sonnet-4-6

# --- Local LLM (preferred: translation + publish metadata via Ollama) ---
# Picked automatically when the Ollama server is reachable; set to force a model.
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_BATCH_SIZE=15          # lines per local chat-model translation request
# Dedicated local MT model (recommended for translation; auto-detected if pulled):
# OLLAMA_MT_MODEL=hf.co/mradermacher/Hunyuan-MT-7B-GGUF:Q4_K_M
# OLLAMA_MT_WORKERS=4           # concurrent per-cue requests
# Publish metadata model (the only LLM step). Default is local qwen3.5:9b (free);
# any Ollama model works (local, or :cloud with credits). Claude is the fallback.
# PUBLISH_MODEL=qwen3.5:9b

# Free online translation (--backend google)
# GOOGLE_TRANSLATE_TARGET=zh-CN
# GOOGLE_TRANSLATE_WORKERS=5

# --- Whisper ASR (caption fallback when YouTube withholds subtitles) ---
# WHISPER_MODEL=small           # tiny|base|small|medium|large-v3
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE=auto

# --- Dubbing ---
# DUB_ENGINE=                   # gpt-sovits | edge | kokoro (default: auto)
# DUB_VOICE=zh-CN-XiaoxiaoNeural
# DUB_WORKERS=8                 # edge-tts concurrency
# Kokoro (local, offline) model files:
# KOKORO_MODEL=models/kokoro-v1.0.onnx
# KOKORO_VOICES=models/voices-v1.0.bin
# KOKORO_VOICE=zf_xiaoxiao
# GPT-SoVITS local server:
# GPT_SOVITS_URL=http://127.0.0.1:9880

# --- Publishing: Bilibili upload via biliup (transdub-upload) ---
# BILIUP_BIN=biliup            # path to the biliup executable
# BILIUP_COOKIES=cookies.json  # credentials from `biliup login`

# --- Monitoring (optional): YouTube Data API v3 + SMTP digest email ---
YOUTUBE_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# SMTP_TLS=true
